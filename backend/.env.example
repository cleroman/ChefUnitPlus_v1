# ============================================================
# ChefUnitPlus - Variables d'environnement
# ============================================================

# --- Application ---
PORT=3000
NODE_ENV=development

# --- Base de donnees ---
# Type : 'sqlite' (local) ou 'postgres' (production)
DB_TYPE=sqlite

# SQLite (local)
DB_PATH=./database/chefunitplus.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL=true

# --- JWT ---
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_32_CHARS
JWT_EXPIRES_IN=7d

# --- FlexPaie ---
FLEXPAIE_BASE_URL=https://api.flexpaie.com/v1
FLEXPAIE_TOKEN=VOTRE_TOKEN_FLEXPAIE
FLEXPAIE_MERCHANT=VOTRE_CODE_MARCHAND
FLEXPAIE_CALLBACK_URL=http://localhost:3000/api/payments/callback

# --- CORS ---
CORS_ORIGIN=*
