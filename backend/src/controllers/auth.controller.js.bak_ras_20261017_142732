// ============================================================
// VALIDATION DES CHAMPS OBLIGATOIRES A L'INSCRIPTION
// ============================================================
function validateRegistration(body) {
  const errors = [];

  // --- Table users ---
  if (!body.email || !body.email.includes('@')) {
    errors.push('Email obligatoire et valide');
  }
  if (!body.phone || body.phone.length < 8) {
    errors.push('Telephone obligatoire (min 8 chiffres)');
  }
  if (!body.password || body.password.length < 6) {
    errors.push('Mot de passe obligatoire (min 6 caracteres)');
  }
  if (!(body.postNom || body.nom) || (body.postNom || body.nom).trim() === '') {
    errors.push('Nom (post_nom) obligatoire');
  }
  if (!body.prenom || body.prenom.trim() === '') {
    errors.push('Prenom obligatoire');
  }
  if (!body.sexe || !['M', 'F'].includes(body.sexe)) {
    errors.push('Sexe obligatoire (M ou F)');
  }
  if (!body.dateNaissance) {
    errors.push('Date de naissance obligatoire');
  }
  if (!body.lieuNaissance || body.lieuNaissance.trim() === '') {
    errors.push('Lieu de naissance obligatoire');
  }

  // --- Table user_details ---
  if ((!body.adresse || body.adresse.trim() === '') && (!body.address || body.address.trim() === '')) {
    errors.push('Adresse obligatoire');
  }
  if ((!body.ville || body.ville.trim() === '') && (!body.city || body.city.trim() === '')) {
    errors.push('Ville obligatoire');
  }
  if (!body.province || body.province.trim() === '') {
    errors.push('Province obligatoire');
  }
  if (!body.commune || body.commune.trim() === '') {
    errors.push('Commune obligatoire');
  }
  if (!body.quartier || body.quartier.trim() === '') {
    errors.push('Quartier obligatoire');
  }
  if ((!body.groupeScout || body.groupeScout.trim() === '') && (!body.scoutGroupId || String(body.scoutGroupId).trim() === '')) {
    errors.push('Groupe scout obligatoire');
  }
  if (!body.branche || body.branche.trim() === '') {
    errors.push('Branche obligatoire');
  }
  if ((!body.niveauEtude || body.niveauEtude.trim() === '') && (!body.educationLevel || body.educationLevel.trim() === '')) {
    errors.push('Niveau etude obligatoire');
  }
  if (!body.conditionsEngagement && !body.engagementAccepte) {
    errors.push('Vous devez accepter les conditions engagement');
  }

  return {
    ok: errors.length === 0,
    errors,
  };
}

// =============================================================
// VALIDER UN UTILISATEUR (avec condition RAS / preuves)
// PATCH /api/auth/admin/users/:userId/validate
// =============================================================
exports.validateUser = async (req, res) => {
  try {
    const { userId } = req.params;
    const adminId = req.user.userId;
    const now = new Date().toISOString();

    // 1. Recuperer l'utilisateur
    const user = await db.prepare(`
      SELECT id, email, statut, fonction, full_name
      FROM users WHERE id = ?
    `).get(userId);

    if (!user) {
      return res.status(404).json({
        success: false,
        message: 'Utilisateur non trouve',
      });
    }

    if (user.statut === 'validated') {
      return res.status(400).json({
        success: false,
        message: 'Utilisateur deja valide',
      });
    }

    // 2. Determiner si RAS
    const fonctionRaw = (user.fonction || '').toString().trim();
    const fonction = fonctionRaw.toUpperCase();
    const isRAS = fonction === 'RAS' || fonction === '' || fonction === 'AUCUN';

    // 3. Compter les preuves
    const proofRow = await db.prepare(`
      SELECT COUNT(*) as c FROM proof_documents WHERE user_id = ?
    `).get(userId);
    const proofCount = (proofRow && proofRow.c) ? parseInt(proofRow.c) : 0;
    const hasProofs = proofCount > 0;

    console.log(`[validateUser] user=${user.email} fonction="${fonctionRaw}" isRAS=${isRAS} proofs=${proofCount}`);

    // 4. CONDITION : si pas RAS ET pas de preuves -> REFUS
    if (!isRAS && !hasProofs) {
      return res.status(400).json({
        success: false,
        message: 'Impossible de valider : aucune preuve de formation attachee. Cet utilisateur doit soumettre ses documents.',
        code: 'PROOFS_REQUIRED',
        fonction: fonctionRaw,
        proofs_count: 0,
      });
    }

    // 5. Marquer les preuves comme validees (si presentes)
    if (hasProofs) {
      await db.prepare(`
        UPDATE proof_documents SET validated_by_admin = 1 WHERE user_id = ?
      `).run(userId);
    }

    // 6. Valider l'utilisateur
    await db.prepare(`
      UPDATE users
      SET statut = 'validated',
          is_active = 1,
          validated_by = ?,
          validated_at = ?,
          updated_at = ?
      WHERE id = ?
    `).run(adminId, now, now, userId);

    console.log(`[validateUser] user ${user.email} valide par admin ${adminId}`);

    return res.json({
      success: true,
      message: isRAS
        ? 'Utilisateur (RAS) valide avec succes'
        : `Utilisateur valide avec succes (${proofCount} preuve(s))`,
      data: {
        userId,
        statut: 'validated',
        validated_at: now,
        is_ras: isRAS,
        fonction: fonctionRaw,
        proofs_count: proofCount,
      },
    });
  } catch (err) {
    console.error('validateUser error:', err);
    return res.status(500).json({
      success: false,
      message: 'Erreur serveur : ' + err.message,
    });
  }
};

