const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const { v4: uuidv4 } = require('uuid');
const db = require('../config/database');
const JWT_SECRET = process.env.JWT_SECRET || 'chefunitplus-secret-key';

// =============================================================
// LOGIN
// =============================================================
exports.login = async (req, res) => {
  try {
    const { email, password } = req.body;

    if (!email || !password) {
      return res.status(400).json({
        success: false,
        message: 'Email et mot de passe requis',
      });
    }

    const user = await db
      .prepare('SELECT * FROM users WHERE email = ?')
      .get(email.trim().toLowerCase());

    if (!user) {
      return res.status(401).json({
        success: false,
        message: 'Aucun compte trouve avec cet email',
        code: 'UNAUTHORIZED',
      });
    }

    if (!user.is_active) {
      // Verifier si c'est un compte en attente d'activation ou suspendu
      const isPending = user.role === 'utilisateur' || user.role === 'apprenant' || user.role === 'formateur';
      return res.status(403).json({
        success: false,
        message: isPending
          ? 'Votre compte est en attente de validation par un administrateur. Vous serez notifie par email une fois valide.'
          : 'Compte suspendu',
        code: isPending ? 'ACCOUNT_PENDING' : 'ACCOUNT_SUSPENDED',
      });
    }

    const valid = await bcrypt.compare(password, user.password_hash);
    if (!valid) {
      return res.status(401).json({
        success: false,
        message: 'Mot de passe incorrect',
        code: 'UNAUTHORIZED',
      });
    }

    const token = jwt.sign(
      { userId: user.id, role: user.role },
      JWT_SECRET,
      { expiresIn: '30d' }
    );

    delete user.password_hash;

    return res.json({
      success: true,
      data: { user, token },
    });
  } catch (err) {
    console.error('login error:', err);
    return res.status(500).json({
      success: false,
      message: 'Erreur serveur',
    });
  }
};

// =============================================================
// REGISTER SCOUT (payload JSON - wizard 6 etapes)
// =============================================================
exports.registerScout = async (req, res) => {
  // ===== VALIDATION OBLIGATOIRE =====
  const validation = validateRegistration(req.body);
  if (!validation.ok) {
    return res.status(422).json({
      success: false,
      message: 'Champs obligatoires manquants',
      errors: validation.errors,
    });
  }
  // ===== FIN VALIDATION =====

  try {
    const payload = req.body;

    console.log('=== REGISTER SCOUT ===');
    console.log('Payload recu:', JSON.stringify(payload, null, 2));

    // ========== VALIDATION ==========
    const required = ['email', 'phone', 'password', 'nom', 'prenom'];
    const missing = required.filter((k) => !payload[k]);
    if (missing.length > 0) {
      return res.status(400).json({
        success: false,
        message: `Champs obligatoires manquants : ${missing.join(', ')}`,
      });
    }

    const email = String(payload.email).trim().toLowerCase();
    const confirmationEmail = String(payload.confirmationEmail || email).trim().toLowerCase();
    const phone = String(payload.phone).trim();
    const password = String(payload.password);

    if (password.length < 6) {
      return res.status(400).json({
        success: false,
        message: 'Mot de passe : minimum 6 caracteres',
      });
    }

    // ========== VERIFIER EMAIL UNIQUE ==========
    const existing = await db
      .prepare('SELECT id FROM users WHERE email = ?')
      .get(email);

    if (existing) {
      return res.status(409).json({
        success: false,
        message: 'Un compte existe deja avec cet email',
      });
    }

    // ========== HASH PASSWORD ==========
    const passwordHash = await bcrypt.hash(password, 10);

    // ========== CREER USER ==========
    const userId = uuidv4();
    const now = new Date().toISOString();

    const fullName = `${payload.prenom || '} ${payload.postNom || payload.nom || '}`.trim();

    // ========== CREER UN GROUPE CUSTOM SI DEMANDE ==========
    let finalGroupId = payload.scoutGroupId || payload.groupId || null;
    if (!finalGroupId && payload.customGroupName) {
      try {
        const customGroupId = uuidv4();
        const checkGroup = await db.prepare('SELECT id FROM scout_groups WHERE name = ?').get(payload.customGroupName);
        if (checkGroup) {
          finalGroupId = checkGroup.id;
          console.log(`  [i] Groupe existant reutilise : ${payload.customGroupName}`);
        } else {
          db.prepare(`
            INSERT INTO scout_groups (id, name, description, is_active, created_at, updated_at)
            VALUES (?, ?, ?, 0, ?, ?)
          `).run(customGroupId, payload.customGroupName, 'Cree automatiquement a l inscription', now, now);
          finalGroupId = customGroupId;
          console.log(`  [OK] Groupe custom cree : ${payload.customGroupName}`);
        }
      } catch (e) {
        console.log(`  [!!] Groupe custom non cree : ${e.message}`);
      }
    }

    // ========== GENERER LE CODE DE VERIFICATION ==========
    const registrationCode = Math.floor(100000 + Math.random() * 900000).toString();
    const codeExpiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();

    // Determiner le statut et les buchettes selon la fonction
    const fonctionRaw = String(
        payload.scoutFunction ||
        payload.fonction ||
        payload.fonctionScout ||
        ''
    ).trim();
    const fonctionUpper = fonctionRaw.toUpperCase();
    const isRAS = fonctionUpper === 'RAS'
                || fonctionUpper === ''
                || fonctionUpper === 'AUCUN';

    const statutInitial = isRAS ? 'awaiting_validation' : 'proofs_pending';
    const buchettesInitial = isRAS ? 0 : 4;

    console.log(`[registerScout] fonction="${fonctionRaw}" isRAS=${isRAS} statut="${statutInitial}" code="${registrationCode}"`);

    // ========== INSERT USER ==========
    const insertUser = await db.prepare(`
      INSERT INTO users (
        id, full_name, email, confirmation_email, phone, password_hash, role,
        post_nom, prenom, sexe, date_naissance, lieu_naissance,
        group_id, totem, adresse,
        avatar_url, photo_url,
        statut, fonction, registration_code, code_is_used,
        code_expires_at, code_attempts, buchettes,
        is_active, created_at, updated_at
      ) VALUES (
        ?, ?, ?, ?, ?, ?, ?,
        ?, ?, ?, ?, ?,
        ?, ?, ?,
        ?, ?,
        ?, ?, ?, 0,
        ?, 0, ?,
        0, ?, ?
      )
    `);

    await insertUser.run(
      userId,
      fullName,
      email,
      confirmationEmail,
      phone,
      passwordHash,
      'utilisateur',
      payload.postNom || payload.nom || null,
      payload.prenom || null,
      payload.sexe || null,
      payload.dateNaissance || null,
      payload.lieuNaissance || null,
      finalGroupId,
      payload.totem || null,
      payload.adresse || null,
      payload.avatarUrl || payload.photoUrl || null,
      payload.photoUrl || payload.avatarUrl || null,
      statutInitial,
      fonctionRaw || null,
      registrationCode,
      codeExpiresAt,
      buchettesInitial,
      now,
      now
    );

    console.log(`[registerScout] User cree avec statut="${statutInitial}" et code="${registrationCode}"`);

    console.log(`  [OK] User cree : ${userId}`);

    // ========== CREER USER_DETAILS ==========
    const detailsId = uuidv4();

    const insertDetails = await db.prepare(`
      INSERT INTO user_details (
        id, user_id,
        post_nom, prenom, prenom2, sexe, date_naissance, lieu_naissance,
        province, ville, commune, quartier, avenue, numero, pays,
        groupe_scout, numero_affiliation, district, association,
        branche, date_entree_scout, fonction_scout,
        profession, niveau_etude, antecedents_medicaux, camps, contacts_urgence,
        engagement_accepte, engagement_date,
        totem, fonctions_camps, personnes_prevenir, conditions_engagement, qr_code_data,
        address, city, country, birth_date,
        education_level, education_field, education_institution,
        scout_formation, scout_role, group_id, profile_photo_url, bio,
        attestation_camp_url,
        created_at, updated_at
      ) VALUES (
        ?, ?,
        ?, ?, ?, ?, ?, ?,
        ?, ?, ?, ?, ?, ?, ?,
        ?, ?, ?, ?,
        ?, ?, ?,
        ?, ?, ?, ?, ?,
        ?, ?,
        ?, ?, ?, ?, ?,
        ?, ?, ?, ?,
        ?, ?, ?,
        ?, ?, ?, ?, ?,
        ?,
        ?, ?
      )
    `);

    const engagement = payload.engagementAccepte ? 1 : 0;

    insertDetails.run(
      detailsId,
      userId,
      payload.postNom || payload.nom || null,
      payload.prenom || null,
      payload.prenom2 || null,
      payload.sexe || null,
      payload.dateNaissance || null,
      payload.lieuNaissance || null,
      payload.province || null,
      payload.ville || null,
      payload.commune || null,
      payload.quartier || null,
      payload.avenue || null,
      payload.numero || null,
      payload.pays || 'RDC',
      payload.groupeScout || null,
      payload.numeroAffiliation || null,
      payload.district || null,
      payload.association || null,
      payload.branche || null,
      payload.dateEntreeScout || null,
      payload.fonction || null,
      payload.profession || null,
      payload.niveauEtude || null,
      payload.antecedentsMedicaux || null,
      payload.camps ? JSON.stringify(payload.camps) : null,
      payload.contacts ? JSON.stringify(payload.contacts) : null,
      engagement,
      engagement ? now : null,
      payload.totem || null,
      payload.fonctionsCamps || null,
      payload.personnesPrevenir || null,
      payload.conditionsEngagement || null,
      payload.qrCodeData || null,
      payload.address || payload.adresse || null,
      payload.city || payload.ville || null,
      payload.country || payload.pays || 'RDC',
      payload.birthDate || payload.dateNaissance || null,
      payload.educationLevel || payload.niveauEtude || null,
      payload.educationField || null,
      payload.educationInstitution || null,
      payload.scoutFormation || null,
      payload.scoutRole || payload.fonction || null,
      payload.groupId || finalGroupId || null,
      payload.profilePhotoUrl || payload.photoUrl || null,
      payload.bio || null,
      payload.attestationCampUrl || null,
      now,
      now
    );

    console.log(`  [OK] UserDetails cree : ${detailsId}`);
    console.log('=== REGISTER SCOUT TERMINE ===');

    // ========== TOKEN ==========
    const token = jwt.sign(
      { userId, role: 'utilisateur' },
      JWT_SECRET,
      { expiresIn: '30d' }
    );

    const user = await db
      .prepare('SELECT id, full_name, email, phone, role, is_active, created_at FROM users WHERE id = ?')
      .get(userId);

    return res.status(201).json({
      success: true,
      message: 'Votre compte a ete cree avec succes. Il est en attente de validation par un administrateur.',
      code: 'ACCOUNT_PENDING',
      data: {
        user: {
          ...user,
          is_active: 0,
        },
        token: null, // Pas de token tant que le compte n'est pas active
        pending: true,
      },
    });
  } catch (err) {
    console.error('registerScout error:', err);
    return res.status(500).json({
      success: false,
      message: 'Erreur lors de la creation du compte : ' + err.message,
    });
  }
};

// =============================================================
// VERIFY EMAIL
// =============================================================
exports.verifyEmail = async (req, res) => {
  try {
    const { email, code } = req.body;
    if (!email || !code) {
      return res.status(400).json({
        success: false,
        message: 'Email et code requis',
      });
    }

    // 1. Recuperer l'utilisateur
    const user = await db.prepare(`
      SELECT id, email, statut, registration_code, code_is_used,
             code_expires_at, code_attempts, code_blocked_until,
             fonction, proofs_submitted_at
      FROM users WHERE LOWER(email) = LOWER(?)
    `).get(email.trim());

    if (!user) {
      return res.status(404).json({
        success: false,
        message: 'Utilisateur introuvable',
      });
    }

    // 2. Verifier si deja utilise
    if (user.code_is_used == 1 || user.code_is_used === true) {
      return res.status(400).json({
        success: false,
        message: 'Ce code a deja ete utilise',
      });
    }

    // 3. Verifier expiration
    if (user.code_expires_at) {
      const expiresAt = new Date(user.code_expires_at);
      if (expiresAt < new Date()) {
        return res.status(400).json({
          success: false,
          message: 'Code expire. Demandez un nouveau code.',
        });
      }
    }

    // 4. Comparer le code
    if (String(user.registration_code) !== String(code).trim()) {
      const attempts = (user.code_attempts || 0) + 1;
      let blockedUntil = null;
      if (attempts >= 5) {
        blockedUntil = new Date(Date.now() + 15 * 60 * 1000).toISOString();
      }
      await db.prepare(`
        UPDATE users SET code_attempts = ?, code_blocked_until = ? WHERE id = ?
      `).run(attempts, blockedUntil, user.id);

      return res.status(400).json({
        success: false,
        message: `Code incorrect (tentative ${attempts}/5)`,
      });
    }

    // 5. CODE CORRECT - Determiner le statut selon la FONCTION
    const fonctionRaw = (user.fonction || '').toString().trim();
    const fonction = fonctionRaw.toUpperCase();
    const isRAS = fonction === 'RAS' || fonction === '' || fonction === 'AUCUN';

    const now = new Date().toISOString();

    if (isRAS) {
      // RAS -> directement valide et actif
      await db.prepare(`
        UPDATE users
        SET code_is_used = 1,
            code_used_at = ?,
            statut = 'validated',
            is_active = 1,
            validated_at = ?,
            updated_at = ?
        WHERE id = ?
      `).run(now, now, now, user.id);

      console.log(`[verifyEmail] RAS user ${user.email} active automatiquement`);
    } else {
      // Non-RAS -> en attente des preuves
      await db.prepare(`
        UPDATE users
        SET code_is_used = 1,
            code_used_at = ?,
            statut = 'proofs_pending',
            updated_at = ?
        WHERE id = ?
      `).run(now, now, user.id);

      console.log(`[verifyEmail] user ${user.email} (${fonctionRaw}) -> proofs_pending`);
    }

    return res.json({
      success: true,
      message: isRAS
        ? 'Code verifie - Compte RAS active'
        : 'Code verifie - Soumettez vos preuves de formation',
      data: {
        is_ras: isRAS,
        fonction: fonctionRaw,
        next_step: isRAS ? 'dashboard' : 'proofs',
        statut: isRAS ? 'validated' : 'proofs_pending',
      },
    });
  } catch (err) {
    console.error('verifyEmail error:', err);
    return res.status(500).json({
      success: false,
      message: 'Erreur serveur : ' + err.message,
    });
  }
};

