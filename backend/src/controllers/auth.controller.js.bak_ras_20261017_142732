// VERIFY EMAIL V2 - Vérifie le code + statut selon fonction
exports.verifyEmailV2 = async (req, res) => {
  try {
    const { email, code } = req.body;
    if (!email || !code) {
      return res.status(400).json({ success: false, message: 'Email et code requis' });
    }

    const user = await db.prepare(`
      SELECT id, email, statut, registration_code, code_is_used,
             code_expires_at, code_attempts, fonction, proofs_submitted_at
      FROM users WHERE LOWER(email) = LOWER(?)
    `).get(email.trim());

    if (!user) {
      return res.status(404).json({ success: false, message: 'Utilisateur introuvable' });
    }

    if (user.code_is_used == 1 || user.code_is_used === true) {
      return res.status(400).json({ success: false, message: 'Ce code a déjà été utilisé' });
    }

    if (user.code_expires_at) {
      const expiresAt = new Date(user.code_expires_at);
      if (expiresAt < new Date()) {
        return res.status(400).json({ success: false, message: 'Code expiré' });
      }
    }

    if (String(user.registration_code) !== String(code).trim()) {
      const attempts = (user.code_attempts || 0) + 1;
      await db.prepare(`UPDATE users SET code_attempts = ? WHERE id = ?`).run(attempts, user.id);
      return res.status(400).json({ success: false, message: `Code incorrect (tentative ${attempts}/5)` });
    }

    const fonctionRaw = (user.fonction || '').toString().trim();
    const fonction = fonctionRaw.toUpperCase();
    const isRAS = fonction === 'RAS' || fonction === '' || fonction === 'AUCUN';
    const now = new Date().toISOString();

    if (isRAS) {
      await db.prepare(`
        UPDATE users SET code_is_used = 1, code_used_at = ?, statut = 'validated',
                         is_active = 1, validated_at = ?, updated_at = ?
        WHERE id = ?
      `).run(now, now, now, user.id);
      console.log(`[verifyEmailV2] RAS user ${user.email} activé`);
    } else {
      await db.prepare(`
        UPDATE users SET code_is_used = 1, code_used_at = ?, statut = 'proofs_pending', updated_at = ?
        WHERE id = ?
      `).run(now, now, user.id);
      console.log(`[verifyEmailV2] user ${user.email} -> proofs_pending`);
    }

    return res.json({
      success: true,
      message: isRAS ? 'Code vérifié - Compte RAS activé' : 'Code vérifié - Soumettez vos preuves',
      data: {
        is_ras: isRAS,
        fonction: fonctionRaw,
        next_step: isRAS ? 'dashboard' : 'proofs',
        statut: isRAS ? 'validated' : 'proofs_pending',
      },
    });
  } catch (err) {
    console.error('verifyEmailV2 error:', err);
    return res.status(500).json({ success: false, message: 'Erreur serveur : ' + err.message });
  }
};

// VALIDATE USER V2 - Refuse si pas RAS ET pas de preuves
exports.validateUserV2 = async (req, res) => {
  try {
    const { userId } = req.params;
    const adminId = req.user.userId;
    const now = new Date().toISOString();

    const user = await db.prepare(`
      SELECT id, email, statut, fonction, full_name FROM users WHERE id = ?
    `).get(userId);

    if (!user) {
      return res.status(404).json({ success: false, message: 'Utilisateur non trouvé' });
    }

    if (user.statut === 'validated') {
      return res.status(400).json({ success: false, message: 'Utilisateur déjà validé' });
    }

    const fonctionRaw = (user.fonction || '').toString().trim();
    const fonction = fonctionRaw.toUpperCase();
    const isRAS = fonction === 'RAS' || fonction === '' || fonction === 'AUCUN';

    const proofRow = await db.prepare(`
      SELECT COUNT(*) as c FROM proof_documents WHERE user_id = ?
    `).get(userId);
    const proofCount = (proofRow && proofRow.c) ? parseInt(proofRow.c) : 0;
    const hasProofs = proofCount > 0;

    console.log(`[validateUserV2] user=${user.email} fonction="${fonctionRaw}" isRAS=${isRAS} proofs=${proofCount}`);

    if (!isRAS && !hasProofs) {
      return res.status(400).json({
        success: false,
        message: 'Impossible de valider : aucune preuve de formation attachée.',
        code: 'PROOFS_REQUIRED',
        fonction: fonctionRaw,
        proofs_count: 0,
      });
    }

    if (hasProofs) {
      await db.prepare(`UPDATE proof_documents SET validated_by_admin = 1 WHERE user_id = ?`).run(userId);
    }

    await db.prepare(`
      UPDATE users SET statut = 'validated', is_active = 1,
                       validated_by = ?, validated_at = ?, updated_at = ?
      WHERE id = ?
    `).run(adminId, now, now, userId);

    console.log(`[validateUserV2] user ${user.email} validé`);

    return res.json({
      success: true,
      message: isRAS ? 'Utilisateur (RAS) validé avec succès' : `Utilisateur validé (${proofCount} preuve(s))`,
      data: { userId, statut: 'validated', is_ras: isRAS, fonction: fonctionRaw, proofs_count: proofCount },
    });
  } catch (err) {
    console.error('validateUserV2 error:', err);
    return res.status(500).json({ success: false, message: 'Erreur serveur : ' + err.message });
  }
};

