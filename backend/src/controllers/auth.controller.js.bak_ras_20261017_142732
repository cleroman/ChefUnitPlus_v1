// ACTIVER UN UTILISATEUR (directeur)
// =============================================================
exports.activateUser = async (req, res) => {
  try {
    const { userId } = req.params;

    const user = await db.prepare('SELECT id, email, confirmation_email FROM users WHERE id = ?').get(userId);
    if (!user) {
      return res.status(404).json({
        success: false,
        message: 'Utilisateur introuvable',
      });
    }

    db.prepare(`UPDATE users SET is_active = '1', updated_at = ? WHERE id = ?`)
      .run(new Date().toISOString(), userId);

    console.log('[OK] User active : ' + user.email);

    // Envoi email de felicitations via Brevo
    try {
      const { sendActivationEmail } = require('../services/email.service');
      const fullUser = await db.prepare('SELECT full_name FROM users WHERE id = ?').get(userId);
      const result = await sendActivationEmail({
        to: (user.confirmation_email || user.email),
        fullName: (fullUser && fullUser.full_name) || 'Cher membre',
      });
      if (result && result.success) {
        console.log('[OK] Email felicitations envoye a ' + (user.confirmation_email || user.email));
      } else {
        console.warn('[!!] Email non envoye : ' + JSON.stringify(result && result.error));
      }
    } catch (emailErr) {
      console.error('[!!] Erreur email :', emailErr.message);
    }

    return res.json({
      success: true,
      message: 'Utilisateur active',
    });
  } catch (err) {
    console.error('activateUser error:', err);
    return res.status(500).json({
      success: false,
      message: 'Erreur serveur : ' + err.message,
    });
  }
};

